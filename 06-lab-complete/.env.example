# Biến môi trường của agent (tiêu chí 9). KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (.env đã nằm trong .gitignore)

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Security — bắt buộc khi ENVIRONMENT=production. Tạo key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis — rate limit và cost guard (docker compose tự đặt redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard: tổng chi phí LLM của service (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
